# Flowboard agent configuration.
#
#   cp .env.example .env    and fill in the two Flow settings below.
#
# Values already present in your shell environment win over this file, so
# `FLOWBOARD_PAYGATE_TIER=... make agent` still overrides it for one run.

# ── Google Flow (required since the September 2026 migration) ──────────────

# The Flow project every board generates into.
#
# Flow no longer lets Flowboard create projects — that endpoint went with the
# migration — so make ONE project in the Flow UI at https://flow.google.com/
# and paste its uuid here. Boards share it.
FLOWBOARD_FLOW_PROJECT_ID=

# Which Flow plan the signed-in account is on.
#
#   PAYGATE_TIER_TWO = Ultra      PAYGATE_TIER_ONE = Pro
#
# This used to be read from Flow's /v1/credits endpoint with the bearer token
# the extension sniffed; nothing mints that token any more, so it has to be
# declared. It is not cosmetic — it picks the video checkpoint — so an
# unrecognised value refuses to dispatch instead of guessing.
FLOWBOARD_PAYGATE_TIER=PAYGATE_TIER_TWO

# ── Optional: everything below already has a working default ───────────────

# WebSocket port the Chrome extension connects to. Changing it here is NOT
# enough: the extension hardcodes the agent's ports, so you must also edit
# `extension/background.js` (AGENT_WS_URL + CALLBACK_URL) and the
# host_permissions in `extension/manifest.json`, then reload the unpacked
# extension.
#
# The agent's HTTP port is not set here — nothing in the agent reads such a
# variable. It comes from `--port` in the Makefile; change
# `FLOWBOARD_HTTP_PORT` at the top of the Makefile (or pass it on the
# command line: `FLOWBOARD_HTTP_PORT=9000 make agent`).
# FLOWBOARD_EXT_WS_PORT=8355
# FLOWBOARD_WS_HOST=127.0.0.1
# FLOWBOARD_STORAGE=./storage
# FLOWBOARD_DB=./storage/flowboard.db

# Planner / auto-prompt backend: "auto" (CLI if available), "cli", or "mock".
# FLOWBOARD_PLANNER_BACKEND=auto
